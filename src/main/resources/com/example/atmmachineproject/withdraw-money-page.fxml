<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.atmmachineproject.WithDrawMoneyController"
      spacing="10"
      prefHeight="400.0" prefWidth="600.0"
      VBox.vgrow="ALWAYS"

>

<padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
</padding>
<fx:include source="nav-bar.fxml"></fx:include>

<stylesheets>
<URL value="@design/style.css"></URL>
</stylesheets>

    <GridPane alignment="CENTER" hgap="5" vgap="5" GridPane.vgrow="ALWAYS" GridPane.hgrow="ALWAYS"   >
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="20"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="20"/>

        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" percentHeight="20"/>
            <RowConstraints vgrow="ALWAYS" percentHeight="20"/>

        </rowConstraints>
    <Button text="50$"
    GridPane.columnIndex="0"
    GridPane.rowIndex="0"
    onAction="#OnPressMoneyAmount"
            maxWidth="Infinity" maxHeight="Infinity"

    ></Button>

    <Button text="100$"
            GridPane.columnIndex="1"
            GridPane.rowIndex="0"
            onAction="#OnPressMoneyAmount"
            maxWidth="Infinity" maxHeight="Infinity"

    ></Button>


    <Button text="200$"
            GridPane.columnIndex="0"
            GridPane.rowIndex="1"
            onAction="#OnPressMoneyAmount"
            maxWidth="Infinity" maxHeight="Infinity"

    ></Button>

    <Button text="500$"
            GridPane.columnIndex="1"
            GridPane.rowIndex="1"
            onAction="#OnPressMoneyAmount"
            maxWidth="Infinity" maxHeight="Infinity"

    ></Button>

    <Text text="Money to withdraw :"
          GridPane.columnIndex="0"
          GridPane.rowIndex="3"
          fx:id="money_text"

    ></Text>

</GridPane>
</VBox>
