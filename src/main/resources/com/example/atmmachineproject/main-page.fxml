<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.example.atmmachineproject.MainPageController"
          prefHeight="400.0" prefWidth="600.0">
    <fx:include source="nav-bar.fxml"></fx:include>
    <Text text="Your Balance"
    GridPane.rowIndex="0"
    GridPane.columnIndex="1"></Text>
    <Text text="1024 $"
    GridPane.rowIndex="1"
    GridPane.columnIndex="1"
          fx:id="money_text"
    ></Text>

    <Button text="Hide" onAction="#OnPressHide"
        GridPane.rowIndex="2"
        GridPane.columnIndex="1"
    ></Button>

    <Button text="Cash Deposit"
    GridPane.rowIndex="3"
    GridPane.columnIndex="0"
    ></Button>
    <Button text="Money Transfer"
    GridPane.rowIndex="3"
    GridPane.columnIndex="1"
    ></Button>
    <Button text="History"
    GridPane.rowIndex="3"
    GridPane.columnIndex="2"
    ></Button>
    <Button text="Cash Withdrawal"
    GridPane.rowIndex="4"
    GridPane.columnIndex="0"
    ></Button>
    <Button text="Change PIN"
    GridPane.rowIndex="4"
    GridPane.columnIndex="1"
    ></Button>
    <Button text="Others"
            GridPane.rowIndex="4"
            GridPane.columnIndex="2"
    ></Button>
</GridPane>
